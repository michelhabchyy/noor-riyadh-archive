# Copy this file to ".env" and fill in real values for LOCAL testing.
# NEVER commit the real .env (it's in .gitignore). On Render, set these same
# keys under the service's "Environment" tab instead.

# The spreadsheet id — from the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_LONG_ID/edit
SHEET_ID=1V912lX0-wht0zSy3YM50rJyBMqzIZEvMGJwIzGfuPQ0

# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Claude fallback (only used if GEMINI_API_KEY is empty)
# ANTHROPIC_API_KEY=

# The ENTIRE service-account JSON key, on ONE line (or a base64 of it).
# Easiest: open the downloaded key file, copy everything, paste between the quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=
